{
  "enabled": true,
  "name": "Setup Godot 4.7 Debug Alias",
  "description": "Creates a godot47-debug shell function that runs Godot 4.7 with debug mode in the current project directory",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "runCommand",
    "command": "echo 'godot47-debug(){ \"${GODOT_BIN:-godot}\" --path . --debug \"$@\"; }' >> ~/.bashrc && echo 'Godot 4.7 debug function added to ~/.bashrc. Set GODOT_BIN if godot is not on PATH, then run \"source ~/.bashrc\" or restart terminal.'"
  }
}
