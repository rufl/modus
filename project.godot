; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="MODUS"
config/tags=PackedStringArray("fps", "gamepad", "menu", "multiplayer")
run/main_scene="res://shared/ui_core/screens/main_menu_screen.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[audio]

default_bus_layout="res://game/default_bus_layout.tres"

[autoload]

GameManager="*res://game/scripts/core/game_manager.gd"
MapGenerator="*res://game/scripts/map_generator/map_generator.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[editor]

script/search_in_file_extensions=PackedStringArray("gd", "gdshader", "tres", "tscn")

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[file_customization]

folder_colors={
".archive": "gray"
}

[filesystem]

import/blender/enabled=false
import/fbx/enabled=false

