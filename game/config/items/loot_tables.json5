        "weight": 45.0,          // 45% chance
        "rarity": "common"
      },
      {
        "item_id": "health_medium",
        "weight": 5.0,           // 5% chance (rare upgrade)
        "rarity": "uncommon"
      }
      // NO EMPTY SLOTS - every swarmling drops something
    ]
  },

  // ===========================
  // TIER 1 - Standard Enemies
  // ===========================
  // Grunts, Imps - common encounters
  // Changed: Removed 30% empty weight, added weapon drops
  "tier1_loot": {
