// =============================================================================
// LOOT TABLES - Enemy Drop Configuration
// =============================================================================
// User Requirement: Every enemy drops loot, with configurable rarities
// 
// STRUCTURE:
//   - "rolls": Number of items to drop per enemy kill
//   - "entries": Array of possible drops with weighted chances
//   - "weight": Relative drop probability (higher = more common)
//   - "is_empty": true means "no drop" (removed for guaranteed drops)
//
// TIERS:
//   - basic_loot: Swarmlings, low-tier fodder (30% drop was too low!)
//   - tier1_loot: Standard enemies (Grunts, Imps)
//   - tier2_loot: Advanced enemies (Healers, Assassins, Rally Captains)
//   - tier3_loot: Elite enemies (Summoners)
//   - tier4_boss_loot: Boss encounters
// =============================================================================

{
  "vase": {
    "rolls": 1,
    "entries": [
      { "item_id": "health_small", "weight": 60.0, "rarity": "common" },
      { "item_id": "ammo_clip", "weight": 40.0, "rarity": "common" }
    ]
  },
  "corpse_pile": {
    "rolls": 1,
    "entries": [
      { "item_id": "ammo_clip", "weight": 60.0, "rarity": "common" },
      { "item_id": "health_small", "weight": 40.0, "rarity": "common" }
    ]
  },
  "hidden_stash": {
    "rolls": 2,
    "entries": [
      { "item_id": "health_medium", "weight": 50.0, "rarity": "uncommon" },
      { "item_id": "ammo_box", "weight": 50.0, "rarity": "uncommon" }
    ]
  },

  // ===========================
  // BASIC LOOT - Swarmlings
  // ===========================
  // Changed: Removed empty slots, guaranteed drops now
  "basic_loot": {
