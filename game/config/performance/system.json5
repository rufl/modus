{
    // =============================================================================
    // SYSTEM CONFIGURATIONS
    // =============================================================================
    // Contains: systems_enabled, network, console, audio_profiles, maps, interaction
    // =============================================================================

    "systems_enabled": {
        // Enable/disable individual game systems for modularity
        // Used by SystemRegistry to control module loading
        "dev_console": true,
        "loot": true,
        "skills": true,
        "combat_feedback": true,
        "chat": true,
        "targeting": true,
        "pain_system": true,
        "gore": true,
        "dismemberment": true,
        "organ_gibs": true,
        "blood_hit_spawner": true,
        "rocket_jump": true,
        "screen_shake": true,
        "movement_polish": true,
        "dodge": true,
        "advanced_movement": true,
        "minimap": true,
        "compass": true,
        "damage_indicator": true,
        "damage_numbers": true,
        "infighting": true,
        "explosion_system": true,
        "status_effects": true,
        "health_bars": true,
        "downed_mechanic": false
    },

    "performance": {
        // Enable performance profiling
        "profiling_enabled": false,
        
        // Log startup time
        "log_startup_time": false
    },

    "prop_replacer": {
        "enabled": false
    },

    "first_person_camera": {
        "enabled": false
    },

    "network": {
        // =====================
        // STEAM INTEGRATION
        // =====================
        
        // Enable Steam networking (requires GodotSteam plugin)
        // When false, always uses ENet (LAN/direct IP)
        "use_steam_networking": false,
        
        // Your Steam App ID (480 = Spacewar test app)
        "steam_app_id": 480,
        
        // Fall back to ENet if Steam is unavailable
        // Recommended: true (allows LAN play without Steam)
        "fallback_to_enet": true,
        
        // =====================
        // SINGLEPLAYER SETTINGS
        // =====================
        
        // Maximum local players for singleplayer/local mode
        // Allows local co-op with up to this many players
        "singleplayer_max_local_players": 4,
        
        // =====================
        // ENET SETTINGS
        // =====================
        
        // Default game port for ENet connections
        "default_port": 9999,
        
        // Maximum players per server
        "max_players": 16,
        
        // Enable UPNP auto port-forwarding
        "use_upnp": true,
        
        // =====================
        // SERVER BROWSER
        // =====================
        
        // Enable LAN server broadcast (UDP)
        "lan_broadcast_enabled": true,
        
        // LAN broadcast port
        "lan_broadcast_port": 9998,
        
        // Server browser refresh interval (seconds)
        "server_list_refresh_interval": 5.0,
        
        // =====================
        // CONNECTION SETTINGS
        // =====================
        
        // Connection timeout (seconds)
        "connection_timeout": 10.0,
        
        // Max reconnection attempts
        "max_reconnect_attempts": 3,
        
        // Base delay between reconnection attempts (ms)
        // Actual delay = base_delay * attempt_number (exponential backoff)
        "reconnect_delay_ms": 2000,
        
        // Session reconnection window (seconds)
        // Players can rejoin within this time after disconnect
        "reconnect_window": 60.0,
        
        // =====================
        // NETCODE TUNING
        // =====================
        
        // Network tick rate (Hz)
        "tick_rate": 60,
        
        // Enable client-side interpolation
        "interpolation_enabled": true,
        
        // Interpolation buffer size (ticks)
        "interpolation_buffer": 2,
        
        // Enable server-side lag compensation
        "lag_compensation_enabled": true,
        
        // Maximum lag compensation window (ms)
        "lag_compensation_max_ms": 200,
        
        // =====================
        // ANTI-CHEAT SETTINGS
        // =====================
        
        // Maximum speed violations before kicking
        "anti_cheat_max_violations": 50,
        
        // Speed tolerance factor (1.2 = 20% over max speed allowed)
        "anti_cheat_speed_tolerance": 1.2,
        
        // Position sync threshold for rubberbanding (meters)
        "anti_cheat_position_threshold": 0.5,
        
        // Enable anti-cheat validation
        "anti_cheat_enabled": true,
        
        // =====================
        // EDITOR SYNC SETTINGS
        // =====================
        
        // Enable realtime multiplayer editing
        "editor_sync_enabled": true,
        
        // Enable delta compression for editor actions
        "editor_sync_compression": true,
        
        // Batch multiple edit actions per tick
        "editor_sync_batch_updates": true,
        
        // =====================
        // RPC RATE LIMITING (Critical #12)
        // =====================
        
        // Rate limits for various RPC methods (calls per second)
        "rpc_rate_limits": {
            // Combat RPCs
            "request_shoot": 10.0,
            "request_damage": 20.0,
            
            // Movement RPCs
            "sync_position": 60.0,
            "request_dodge": 2.0,
            
            // Weapon RPCs
            "request_weapon_switch": 5.0,
            "request_reload": 10.0,
            
            // Item RPCs
            "request_pickup": 5.0,
            "request_drop": 2.0,
            "request_use_item": 10.0,
            
            // Social RPCs
            "send_chat_message": 3.0,
            
            // Admin RPCs
            "kick_player": 0.1,
            
            // Match Service RPCs
            "update_player_status": 10.0,
            "register_kill": 5.0,
            
            // Player State Manager RPCs
            "set_player_state": 5.0,
            "set_player_mode": 2.0,
            
            // Network Editor RPCs
            "place_block": 10.0,
            "delete_node": 10.0,
            "paint_block": 15.0
        }
    },

    "console": {
        "enabled": true,
        "toggle_key": "KEY_QUOTELEFT",  // ~ key (backtick/tilde)
        
        // Appearance
        "width_percent": 90,
        "height_percent": 65,
        "background_color": { "r": 0.05, "g": 0.05, "b": 0.1, "a": 0.92 },
        "text_color": { "r": 0.9, "g": 0.9, "b": 0.95, "a": 1.0 },
        "input_color": { "r": 0.3, "g": 1.0, "b": 0.3, "a": 1.0 },
        "error_color": { "r": 1.0, "g": 0.3, "b": 0.3, "a": 1.0 },
        "warning_color": { "r": 1.0, "g": 0.8, "b": 0.2, "a": 1.0 },
        "debug_color": { "r": 0.6, "g": 0.6, "b": 0.6, "a": 1.0 },
        "info_color": { "r": 0.9, "g": 0.9, "b": 0.95, "a": 1.0 },
        
        // Typography
        "font_size": 14,
        "line_spacing": 4,
        
        // Animation
        "slide_duration": 0.25,
        
        // Buffer
        "max_log_lines": 1000,
        "history_size": 50
    },

    "audio_profiles": {
        "weapons": {
            "Pistol": {
                "pitch": 1.0,
                "volume_db": 0.0
            },
            "Shotgun": {
                "pitch": 0.7,
                "volume_db": 3.0
            },
            "Machine Gun": {
                "pitch": 1.3,
                "volume_db": -2.0
            },
            "Rocket Launcher": {
                "pitch": 0.5,
                "volume_db": 5.0
            },
            "Chaingun": {
                "pitch": 0.8,
                "volume_db": 0.0
            },
            "Grenade Launcher": {
                "pitch": 0.6,
                "volume_db": 2.0
            }
        }
    },

    "maps": {
        // Map Aliases Configuration
        // Format: "alias": "path/to/scene.tscn" (relative to game/levels/)
        // OR: "alias": "res://full/path/to/scene.tscn"
        
        "default": "res://game/world/maps/showcase.tscn",
        "map": "res://game/levels/map.tscn", 
        "showcase": "res://game/world/maps/showcase.tscn",
        
        // Test Maps
        "weapons": "res://game/scenes/test_quake_weapons.tscn",
        "gibtest": "res://game/tests/gib_test.tscn",
        "projectiles": "res://game/tests/projectile_test.tscn",
        "mission": "res://game/tests/test_mission.tscn"
    },

    "interaction": {
        // Pickup mechanics
        "pickup": {
            "range": 3.0,              // Max distance to pick up objects
            "hold_distance": 2.0,      // Distance held objects float in front of player
            "throw_force": 15.0,       // Force applied when throwing
            "throw_upward_bias": 0.2   // Slight upward angle on throw (0-1)
        },
        
        // Interaction raycast
        "raycast": {
            "length": 4.0,             // How far player can interact
            "collision_mask": 8        // Collision layer for interactables
        },
        
        // Key and collectible settings
        "keys": {
            "persist_on_death": false, // Keep keys when dying
            "show_collected_ui": true  // Show key icons on HUD
        },
        
        // Door interaction
        "doors": {
            "use_cooldown": 0.5,       // Seconds between door uses
            "auto_close_time": 5.0     // Seconds before door auto-closes (0 = never)
        },
        
        // Tooltip display
        "tooltip": {
            "show_interaction_prompts": true,
            "prompt_prefix": "[E] ",
            "font_size": 16,
            "offset_y": 50
        }
    }
}
