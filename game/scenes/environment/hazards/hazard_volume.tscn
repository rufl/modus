[sub_resource type="BoxMesh" id="BoxMesh_hazard"]
material = SubResource("ShaderMaterial_lava")
size = Vector3(10, 1, 10)

[sub_resource type="GDScript" id="GDScript_hazard"]
script/source = "extends Area3D

@export var damage_per_second: float = 20.0
@export var damage_type: DamageInfo.DamageType = DamageInfo.DamageType.VOID

func _ready() -> void:
	body_entered.connect(_on_body_entered)

func _process(delta: float) -> void:
	for body in get_overlapping_bodies():
		if body.has_method(\"take_damage\"):
			var damage_info: DamageInfo = DamageInfo.create(damage_per_second * delta, damage_type, self)
			body.take_damage(damage_info)

func _on_body_entered(body: Node3D) -> void:
	# Optional: Play sound effect when entering hazard
	pass
"

[sub_resource type="BoxShape3D" id="BoxShape3D_hazard"]
size = Vector3(10, 1, 10)

[node name="HazardVolume" type="Area3D"]
script = SubResource("GDScript_hazard")

[node name="MeshInstance3D" type="MeshInstance3D" parent="."]
mesh = SubResource("BoxMesh_hazard")

