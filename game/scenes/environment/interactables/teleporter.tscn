[gd_scene format=3 uid="uid://teleporter"]

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_frame"]
albedo_color = Color(0.1, 0.1, 0.1, 1)
metallic = 1.0
roughness = 0.2

[sub_resource type="TorusMesh" id="TorusMesh_frame"]
material = SubResource("StandardMaterial3D_frame")
inner_radius = 1.8
outer_radius = 2.0

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_swirl"]
transparency = 1
blend_mode = 1
shading_mode = 0
albedo_color = Color(0.4, 0.2, 1, 0.6)

[sub_resource type="SphereMesh" id="SphereMesh_swirl"]
material = SubResource("StandardMaterial3D_swirl")
radius = 1.7
height = 3.4

[sub_resource type="GDScript" id="GDScript_teleporter"]
script/source = "extends Area3D

@export var target_node_path: NodePath
@export var teleport_cooldown: float = 2.0
@export var sound_effect: String = \"teleport\"

var _timer: float = 0.0

func _ready() -> void:
	body_entered.connect(_on_body_entered)

func _process(delta: float) -> void:
	if _timer > 0:
		_timer -= delta

func _on_body_entered(body: Node3D) -> void:
	if _timer > 0: return
	
	var target = get_node_or_null(target_node_path)
	if target and body.has_method(\"set_global_position\"):
		# Feedback OLD pos
		_spawn_feedback(body.global_position)
		
		# Teleport
		body.global_position = target.global_position
		
		# Feedback NEW pos
		_spawn_feedback(body.global_position)
		
		var game_manager := get_node_or_null(\"/root/GameManager\")
		var audio_service: Node = game_manager.get_core_system(\"audio\") if game_manager else null
		if audio_service and audio_service.has_method(\"play_sfx_at_position\"):
			audio_service.play_sfx_at_position(sound_effect, body.global_position)
			
		_timer = teleport_cooldown

func _spawn_feedback(pos: Vector3) -> void:
	var game_manager := get_node_or_null(\"/root/GameManager\")
	var effects_service: Node = game_manager.get_core_system(\"effects\") if game_manager else null
	if effects_service and effects_service.has_method(\"spawn_explosion\"):
		effects_service.spawn_explosion.rpc(pos, 0.5)
"

[sub_resource type="BoxShape3D" id="BoxShape3D_trigger"]
size = Vector3(2, 3, 1)

[sub_resource type="ParticleProcessMaterial" id="ParticleProcessMaterial_swirl"]
emission_shape = 1
emission_sphere_radius = 1.5
direction = Vector3(0, 1, 0)
spread = 180.0
gravity = Vector3(0, 0, 0)
radial_accel_min = -5.0
radial_accel_max = -2.0
color = Color(0.6, 0.3, 1, 0.8)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_spark"]
transparency = 1
shading_mode = 0
vertex_color_use_as_albedo = true
billboard_mode = 3
particles_anim_h_frames = 1
particles_anim_v_frames = 1
particles_anim_loop = false

[sub_resource type="QuadMesh" id="QuadMesh_spark"]
material = SubResource("StandardMaterial3D_spark")
size = Vector2(0.1, 0.1)

[node name="Teleporter" type="Area3D"]
script = SubResource("GDScript_teleporter")

[node name="Frame" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, -4.37114e-08, -1, 0, 1, -4.37114e-08, 0, 2, 0)
mesh = SubResource("TorusMesh_frame")

[node name="Swirl" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 0.2, 0, 2, 0)
mesh = SubResource("SphereMesh_swirl")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2, 0)
shape = SubResource("BoxShape3D_trigger")

[node name="GPUParticles3D" type="GPUParticles3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2, 0)
amount = 32
process_material = SubResource("ParticleProcessMaterial_swirl")
draw_pass_1 = SubResource("QuadMesh_spark")

[node name="OmniLight3D" type="OmniLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2, 0)
light_color = Color(0.6, 0.4, 1, 1)
light_energy = 3.0
omni_range = 5.0
