      "corpse_scene": "res://game/entities/enemies/dummy/dummy_ragdoll.tscn"
    },
  },

  // =====================
  // ELITE MODIFIERS
  // =====================
  // Applied to any enemy that becomes "elite"
  "tier_elite_modifier": {
    "health_mult": 2.0,          // 2x health
