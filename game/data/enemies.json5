      "weapon_preference": "ranged",
      "uses_cover": false,
      "flee_threshold": 0.5,     // Flees easily
    },
    "loot": {
      "loot_table_id": "tier1_loot",
      "drop_chance": 0.3,
    },
    "visuals": {
