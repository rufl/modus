[gd_scene load_steps=7 format=3]

[ext_resource type="PackedScene" path="res://game/scenes/environment/door.tscn" id="1_door"]
[ext_resource type="PackedScene" path="res://game/scenes/environment/interactables/button_stand.tscn" id="2_button"]
[ext_resource type="PackedScene" path="res://game/scenes/environment/interactables/lever.tscn" id="3_lever"]
[ext_resource type="PackedScene" path="res://game/scenes/environment/moving_platform.tscn" id="4_platform"]

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_floor"]
albedo_color = Color(0.2, 0.25, 0.2, 1)

[sub_resource type="GDScript" id="GDScript_connector"]
script/source = "extends Node3D

## Interactables Demo Controller
## Connects buttons/levers to doors/platforms

@export var button1: Node3D
@export var door1: Node3D
@export var lever1: Node3D
@export var platform1: Node3D

func _ready() -> void:
	# Connect button to door
	if button1 and door1:
		if button1.has_signal(\"activated\"):
			button1.activated.connect(_on_button1_activated)
		elif button1.has_signal(\"pressed\"):
			button1.pressed.connect(_on_button1_activated)
	
	# Connect lever to platform
	if lever1 and platform1:
		if lever1.has_signal(\"toggled\"):
			lever1.toggled.connect(_on_lever1_toggled)
		elif lever1.has_signal(\"activated\"):
			lever1.activated.connect(_on_lever1_activated)

func _on_button1_activated() -> void:
	if door1 and door1.has_method(\"toggle\"):
		door1.toggle()
	elif door1 and door1.has_method(\"open\"):
		door1.open()

func _on_lever1_toggled(is_on: bool) -> void:
	if platform1 and platform1.has_method(\"set_active\"):
		platform1.set_active(is_on)

func _on_lever1_activated() -> void:
	if platform1 and platform1.has_method(\"toggle\"):
		platform1.toggle()
"

[node name="InteractablesDemo" type="Node3D"]
script = SubResource("GDScript_connector")

[node name="Floor" type="CSGBox3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.5, 0)
use_collision = true
size = Vector3(20, 1, 20)
material = SubResource("StandardMaterial3D_floor")

[node name="TitleLabel" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 3, -9)
text = "Interactables Demo
Buttons, Levers, Doors, Platforms"
font_size = 32
modulate = Color(1, 0.8, 0.3, 1)

[node name="ButtonDoorSection" type="Node3D" parent="."]

